{
  "name": "sentinel-web-observatory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server-entry.ts",
    "start": "node server.js",
    "build": "node ./node_modules/vite/bin/vite.js build && node scripts/build-server.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test server/investigation.test.ts",
    "clean": "node -e \"for (const p of ['dist','server.js']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
