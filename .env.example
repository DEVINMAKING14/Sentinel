# Optional. Keep real credentials in an untracked .env file locally or in the
# deployment platform's secret manager. Never put a real key in this file.
GEMINI_API_KEY=

# Optional local development port. Production platforms usually provide PORT.
PORT=3000

# Optional. Set only to trusted proxy network names/IPs/CIDRs when deployed
# behind a reverse proxy; never use "true" or a hop count.
TRUST_PROXY=
